generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
  NOT_SPECIFIED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum SourceType {
  ADMIN_FORM
  CSV_IMPORT
  EXTERNAL_SOURCE
}

enum ApplicationStatus {
  SAVED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum InterviewType {
  ONLINE_ASSESSMENT
  CODING_ROUND
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  MANAGERIAL_INTERVIEW
  TAKE_HOME_ASSIGNMENT
  OTHER
}

enum InterviewResult {
  PENDING
  CLEARED
  REJECTED
  CANCELLED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ReminderType {
  APPLICATION_FOLLOW_UP
  INTERVIEW_PREPARATION
  INTERVIEW_DATE
  ASSESSMENT_DEADLINE
  INTERNSHIP_DEADLINE
  RECRUITER_CONTACT
  CUSTOM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReminderStatus {
  PENDING
  COMPLETED
  SNOOZED
  CANCELLED
}

enum NoteCategory {
  GENERAL
  COMPANY_RESEARCH
  INTERVIEW_PREP
  TECHNICAL_QUESTIONS
  HR_QUESTIONS
  ASSESSMENT_NOTES
  FOLLOW_UP
}

enum ReportReason {
  BROKEN_LINK
  EXPIRED
  INCORRECT_INFO
  SUSPICIOUS_OR_FRAUD
  DUPLICATE
  MISLEADING_ELIGIBILITY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                   String            @id @default(cuid())
  name                 String?
  email                String            @unique
  emailVerified        DateTime?
  passwordHash         String?
  image                String?
  role                 Role              @default(STUDENT)
  college              String?
  degree               String?
  branch               String?
  graduationYear       Int?
  skills               String[]          @default([])
  preferredRoles       String[]          @default([])
  preferredWorkModes   WorkMode[]        @default([])
  preferredLocations   String[]          @default([])
  minimumStipend       Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  accounts             Account[]
  sessions             Session[]
  savedInternships     SavedInternship[]
  applications         Application[]
  interviews           Interview[]
  reminders            Reminder[]
  notes                Note[]
  reports              InternshipReport[]
  createdListings      Internship[]      @relation("AdminCreatedListings")
  verifiedListings     Internship[]      @relation("AdminVerifiedListings")
  importBatches        ImportBatch[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Internship {
  id                     String             @id @default(cuid())
  title                  String
  companyName            String
  companyWebsite         String?
  companyLogoUrl         String?
  shortDescription       String
  description            String             @db.Text
  responsibilities       String?            @db.Text
  requiredSkills         String[]           @default([])
  preferredSkills        String[]           @default([])
  eligibleDegrees        String[]           @default([])
  eligibleBranches       String[]           @default([])
  eligibleGraduationYears Int[]             @default([])
  location               String?
  workMode               WorkMode           @default(NOT_SPECIFIED)
  stipendMin             Int?
  stipendMax             Int?
  currency               String             @default("INR")
  duration               String?
  deadline               DateTime?
  publishedAt            DateTime?
  officialApplyUrl       String
  sourceUrl              String?
  sourceType             SourceType         @default(ADMIN_FORM)
  externalSourceId       String?
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  lastVerifiedAt         DateTime?
  verifiedById           String?
  status                 ListingStatus      @default(DRAFT)
  createdById            String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  createdBy              User               @relation("AdminCreatedListings", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy             User?              @relation("AdminVerifiedListings", fields: [verifiedById], references: [id], onDelete: SetNull)
  savedBy                SavedInternship[]
  applications           Application[]
  reports                InternshipReport[]

  @@index([status, deadline])
  @@index([companyName])
  @@index([title])
  @@index([verificationStatus])
  @@index([workMode])
}

model SavedInternship {
  id           String     @id @default(cuid())
  userId       String
  internshipId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([userId, internshipId])
  @@index([userId])
  @@index([internshipId])
}

model Application {
  id               String                    @id @default(cuid())
  userId           String
  internshipId     String?
  companyName      String
  roleTitle        String
  jobUrl           String?
  source           String?
  status           ApplicationStatus         @default(SAVED)
  appliedAt        DateTime?
  resumeVersion    String?
  recruiterName    String?
  recruiterContact String?
  nextAction       String?
  nextActionAt     DateTime?
  notes            String?                   @db.Text
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship       Internship?               @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  history          ApplicationStatusHistory[]
  interviews       Interview[]
  reminders        Reminder[]
  linkedNotes      Note[]

  @@index([userId, status])
  @@index([userId, nextActionAt])
  @@index([internshipId])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  previousStatus ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String
  note          String?
  createdAt     DateTime           @default(now())

  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Interview {
  id               String          @id @default(cuid())
  userId           String
  applicationId    String
  type             InterviewType   @default(TECHNICAL_INTERVIEW)
  roundName        String?
  scheduledAt      DateTime
  timeZone         String          @default("Asia/Kolkata")
  durationMinutes  Int?
  meetingUrl       String?
  interviewerName  String?
  preparationNotes String?         @db.Text
  feedback         String?         @db.Text
  result           InterviewResult @default(PENDING)
  status           InterviewStatus @default(SCHEDULED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reminders        Reminder[]
  notes            Note[]

  @@index([userId, scheduledAt])
  @@index([applicationId])
}

model Reminder {
  id            String         @id @default(cuid())
  userId        String
  applicationId String?
  interviewId   String?
  title         String
  description   String?
  type          ReminderType   @default(CUSTOM)
  dueAt         DateTime
  timeZone      String         @default("Asia/Kolkata")
  priority      Priority       @default(MEDIUM)
  status        ReminderStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview     Interview?     @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([applicationId])
}

model Note {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  interviewId   String?
  title         String
  content       String       @db.Text
  category      NoteCategory @default(GENERAL)
  tags          String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview     Interview?   @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([applicationId])
}

model InternshipReport {
  id             String       @id @default(cuid())
  userId         String
  internshipId   String
  reason         ReportReason
  description    String?      @db.Text
  status         ReportStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  resolutionNote String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship     Internship   @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([internshipId])
  @@index([userId])
}

model ImportBatch {
  id             String       @id @default(cuid())
  adminId        String
  fileName       String
  status         ImportStatus @default(PROCESSING)
  totalRows      Int          @default(0)
  successfulRows Int          @default(0)
  failedRows     Int          @default(0)
  skippedRows    Int          @default(0)
  errorSummary   String?      @db.Text
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  admin          User         @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
}
